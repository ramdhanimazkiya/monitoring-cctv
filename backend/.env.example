# =============================================================================
# CCTV Monitoring & Audio Paging - backend environment
# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit file `.env`.
# =============================================================================

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL lokal, tanpa Docker) --------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# User harus punya hak CREATEDB agar `prisma migrate dev` dapat membuat shadow database.
DATABASE_URL="postgresql://cctv_app:GANTI_PASSWORD_DB@localhost:5432/monitoring_cctv?schema=public"

# --- Seed data demo (HANYA development) ---------------------------------------
# Password akun demo. Wajib diisi saat menjalankan `npm run db:seed`.
# Minimal 12 karakter. Seed menolak berjalan jika NODE_ENV=production.
SEED_ADMIN_PASSWORD="GANTI_PASSWORD_ADMIN_DEMO"
SEED_OPERATOR_PASSWORD="GANTI_PASSWORD_OPERATOR_DEMO"

# --- Sesi & Keamanan (Tahap 3) ------------------------------------------------
SESSION_SECRET="ganti_dengan_kunci_rahasia_acak_minimal_32_karakter_untuk_cookie"
SESSION_COOKIE_NAME="cctv_session"
SESSION_TTL_HOURS=8
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- Enkripsi kredensial perangkat (dipakai mulai Tahap 4) ---------------------
# 32 byte acak dalam base64. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Kehilangan kunci ini = kredensial perangkat tersimpan tidak dapat dibaca lagi.
CREDENTIAL_ENCRYPTION_KEY=

# --- Media Streaming Gateway (Tahap 5) ----------------------------------------
STREAM_GATEWAY_URL="http://localhost:8554"
STREAM_GATEWAY_API_URL="http://localhost:9997"
STREAM_GATEWAY_TYPE="mediamtx"

